<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#121212" android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/recordings_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/recordings_title" android:textColor="@color/brand_orange" android:textSize="28sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
        <Spinner android:id="@+id/recording_channel" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/premium_panel_background" />
        <EditText android:id="@+id/recording_date" android:layout_width="180dp" android:layout_height="56dp" android:layout_marginStart="12dp" android:hint="YYYY-MM-DD" android:inputType="date" android:textColor="@color/white" android:textColorHint="#88FFFFFF" />
        <EditText android:id="@+id/recording_time" android:layout_width="110dp" android:layout_height="56dp" android:layout_marginStart="12dp" android:hint="HH:mm" android:inputType="time" android:textColor="@color/white" android:textColorHint="#88FFFFFF" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_search_recordings" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginStart="12dp" android:text="@string/search_recordings" android:backgroundTint="@color/brand_orange" />
    </LinearLayout>
    <ProgressBar android:id="@+id/recordings_progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:layout_marginTop="20dp" android:visibility="gone" />
    <TextView android:id="@+id/recordings_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:text="@string/select_date_to_search" android:textColor="#AAFFFFFF" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recordings_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1" />
</LinearLayout>
