<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="6dp" android:focusable="true" android:clickable="true"
    android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="#202024" app:cardCornerRadius="14dp" app:strokeColor="#44FF7A00" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
        <TextView android:id="@+id/segment_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/segment_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/brand_orange_bright" android:textSize="14sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
