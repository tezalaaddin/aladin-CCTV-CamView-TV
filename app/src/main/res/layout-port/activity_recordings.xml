<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#121212" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/recordings_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recordings_title" android:textColor="@color/brand_orange" android:textSize="23sp" android:textStyle="bold" />
    <Spinner android:id="@+id/recording_channel" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/premium_panel_background" />
    <EditText android:id="@+id/recording_date" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:hint="YYYY-MM-DD" android:inputType="date" android:textColor="@color/white" android:textColorHint="#88FFFFFF" />
    <EditText android:id="@+id/recording_time" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:hint="HH:mm" android:inputType="time" android:textColor="@color/white" android:textColorHint="#88FFFFFF" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_search_recordings" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="@string/search_recordings" android:backgroundTint="@color/brand_orange" />
    <ProgressBar android:id="@+id/recordings_progress" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center" android:layout_marginTop="12dp" android:visibility="gone" />
    <TextView android:id="@+id/recordings_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="@string/select_date_to_search" android:textColor="#AAFFFFFF" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recordings_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_weight="1" />
</LinearLayout>
